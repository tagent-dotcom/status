# Copy to .env.local for development. Every variable is validated at startup (src/lib/config.ts).

# Postgres connection string (required).
DATABASE_URL=postgres://status:status@localhost:5432/status
# Max connections per app instance. Keep instances x pool size below Postgres max_connections.
DATABASE_POOL_MAX=10

# Public origin, used for canonical URLs, robots.txt and the sitemap. No trailing slash.
SITE_URL=http://localhost:3000

# Secret for hashing client IPs (rate limiting without storing IPs). At least 16 characters.
# Generate one with: openssl rand -hex 32
IP_HASH_SECRET=change-me-to-a-long-random-string

# Globalping probe network. Without a token you are limited to 50 probes per check and a small
# hourly allowance shared with everyone on your IP. Get a free token at https://dash.globalping.io
GLOBALPING_API_URL=https://api.globalping.io
GLOBALPING_TOKEN=
# Our own hourly ceiling on probes (all instances combined) so spikes can't burn your credits.
GLOBALPING_HOURLY_PROBE_BUDGET=250
MAX_PROBES_PER_CHECK=50

# Identical checks (same URL + same locations) within this many seconds share one measurement.
CHECK_DEDUPE_SECONDS=60

# Per-client limits for starting new checks (reusing a recent identical check is free).
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_HOUR=30
# Set to true ONLY behind a proxy/CDN that sets X-Forwarded-For / X-Real-IP / CF-Connecting-IP
# (Vercel, Cloudflare, nginx). Otherwise every visitor shares one rate-limit bucket.
TRUST_PROXY_HEADERS=false

# How long per-probe results are kept by `npm run db:prune`.
RESULT_RETENTION_DAYS=400
